<section class="archivist-sheet archivist-sheet-quest">
    <aside class="archivist-sidebar">
        <header class="archivist-header">
            {{#if setup.image}}
            <img class="archivist-avatar" src="{{setup.image}}" alt="" />
            {{else}}
            <div class="archivist-avatar archivist-avatar-placeholder">
                <i class="fa-solid fa-scroll"></i>
            </div>
            {{/if}}
            {{#if setup.editingInfo}}
            <input class="archivist-title-input" type="text" value="{{setup.name}}" />
            {{else}}
            <h2 class="archivist-title">{{setup.name}}</h2>
            {{/if}}
            <small class="archivist-subtitle">Quest</small>
            <div class="quest-badges">
                <span class="quest-status-badge quest-status-{{quest.status}}">
                    <i class="fa-solid {{quest.statusIcon}}"></i> {{quest.statusLabel}}
                </span>
                {{#if quest.categoryLabel}}
                <span class="quest-category-badge">{{quest.categoryLabel}}</span>
                {{/if}}
            </div>
            {{#if setup.isGM}}
            <button type="button" class="archivist-edit-toggle" data-action="toggle-edit-mode"
                title="{{#if setup.editingInfo}}Save Changes{{else}}Edit Sheet{{/if}}">
                {{#if setup.editingInfo}}<i class="fa-solid fa-unlock"></i>{{else}}<i
                    class="fa-solid fa-lock"></i>{{/if}}
            </button>
            {{/if}}
        </header>
        <nav class="archivist-nav tabs" data-group="archivist">
            <a class="item" data-tab="info">Info</a>
            <a class="item" data-tab="objectives">Objectives</a>
            <a class="item" data-tab="progress">Progress</a>
            <a class="item" data-tab="links">Links</a>
            <a class="item" data-tab="notes">GM Notes</a>
        </nav>
    </aside>
    <main class="archivist-content">
        <section class="tab" data-tab="info">
            <div class="archivist-info">
                {{#if setup.editingInfo}}
                <prose-mirror name="text.content" value="{{setup.rawContent}}" document-uuid="{{setup.pageUuid}}"
                    compact="true" toggled data-toggled="true">
                    {{{htmlContent}}}
                </prose-mirror>
                {{else}}
                {{{htmlContent}}}
                {{/if}}
            </div>
            <div class="quest-metadata">
                {{#if quest.questGiver}}
                <div class="quest-field-group">
                    <label>Quest Giver</label>
                    <span>{{quest.questGiver}}</span>
                </div>
                {{/if}}
                {{#if quest.successDefinition}}
                <div class="quest-field-group">
                    <label>Success Definition</label>
                    <span>{{quest.successDefinition}}</span>
                </div>
                {{/if}}
                {{#if quest.failureConditions}}
                <div class="quest-field-group">
                    <label>Failure Conditions</label>
                    <span>{{quest.failureConditions}}</span>
                </div>
                {{/if}}
                {{#if quest.nextAction}}
                <div class="quest-field-group">
                    <label>Next Action</label>
                    <span>{{quest.nextAction}}</span>
                </div>
                {{/if}}
                {{#if quest.resolution}}
                <div class="quest-field-group">
                    <label>Resolution</label>
                    <span>{{quest.resolution}}</span>
                </div>
                {{/if}}
                {{#if quest.firstSession}}
                <div class="quest-field-group">
                    <label>First Session</label>
                    <span>{{quest.firstSession.title}}</span>
                </div>
                {{/if}}
                {{#if quest.lastSession}}
                <div class="quest-field-group">
                    <label>Last Session</label>
                    <span>{{quest.lastSession.title}}</span>
                </div>
                {{/if}}
            </div>
        </section>
        <section class="tab" data-tab="objectives">
            <h3 class="quest-section-heading">Objectives</h3>
            {{#if setup.editingInfo}}
            <button type="button" class="quest-add-btn" data-action="add-objective">
                <i class="fa-solid fa-plus"></i> Add Objective
            </button>
            {{/if}}
            <ol class="quest-objectives-list">
                {{#each quest.objectives}}
                <li class="quest-objective quest-objective-{{this.status}}" data-obj-index="{{@index}}">
                    <span class="quest-objective-text">{{this.text}}</span>
                    {{#if ../setup.editingInfo}}
                    <button type="button" class="quest-remove-btn" data-action="remove-objective" title="Remove">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                    {{/if}}
                </li>
                {{/each}}
            </ol>
        </section>
        <section class="tab" data-tab="progress">
            <h3 class="quest-section-heading">Progress Log</h3>
            <ul class="quest-progress-log">
                {{#each quest.progressLog}}
                <li class="quest-progress-entry">{{this}}</li>
                {{/each}}
            </ul>
        </section>
        <section class="tab" data-tab="links">
            <h3 class="quest-section-heading">Related Entities</h3>
            <div class="quest-related-section">
                <h4>Characters</h4>
                <div class="quest-related-characters"></div>
            </div>
            <div class="quest-related-section">
                <h4>Factions</h4>
                <div class="quest-related-factions"></div>
            </div>
            <div class="quest-related-section">
                <h4>Locations</h4>
                <div class="quest-related-locations"></div>
            </div>
            <div class="quest-related-section">
                <h4>Items</h4>
                <div class="quest-related-items"></div>
            </div>
        </section>
        <section class="tab" data-tab="notes">
            {{#if setup.isGM}}
            <div class="archivist-notes">
                <prose-mirror name="gmNotes" value="{{setup.gmNotes}}" compact="true" toggled>
                    {{{setup.gmNotes}}}
                </prose-mirror>
            </div>
            {{else}}
            <div class="archivist-notes">
                <p class="hint"><i class="fas fa-lock"></i> GM-only notes are not visible to players.</p>
            </div>
            {{/if}}
        </section>
    </main>
</section>
